# Copy to .env.local for local dev, and set the same keys in Vercel for prod.

# --- MongoDB ---
# Local dev used Docker Mongo (mongodb://127.0.0.1:27017/personaverse).
# For Vercel, use the Atlas SRV connection string (Vercel reaches Atlas fine):
#   mongodb+srv://<user>:<pass>@cluster0.ddax8e5.mongodb.net/personaverse?retryWrites=true&w=majority&appName=Cluster0
# Atlas > Network Access must allow 0.0.0.0/0 (Vercel has no static egress IPs).
MONGODB_URI=

# --- Clerk auth (note the NEXT_PUBLIC_ prefix on the publishable key) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- LLM providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional fallback (auto-activates on a Gemini 429 if present):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_TIMEOUT_MS=20000

# --- Pipeline tuning (safe defaults; raise on a paid key) ---
LLM_PROVIDER=gemini
SIM_SAMPLE_BUCKETS=12
SIM_CONCURRENCY=3
SIM_PRIMARY_WEIGHT=3
SIM_BUDGET_MS=50000
